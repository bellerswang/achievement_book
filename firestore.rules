rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- existing project rule, unchanged ---------------------------------
    // Clients cannot read or write anything by default (this keeps the
    // existing `records` voice-notes collection server-only, as before).
    match /{document=**} {
      allow read, write: if false;
    }

    // ---- 成就本 (achievement_book): append-only event log -----------------
    // users/{uid}/achievement_events/{eventId}
    // A signed-in parent can read their own events and append new ones.
    // Events are immutable: no edits, no deletes (corrections are new events).
    // Re-sending an identical event (retry after a dropped connection) is a
    // no-op and allowed.
    match /users/{uid}/achievement_events/{eventId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validEvent() {
        let d = request.resource.data;
        return d.keys().hasOnly(['id', 'timestamp', 'sport', 'eventType', 'schemaVersion', 'payload'])
          && d.keys().hasAll(['id', 'timestamp', 'sport', 'eventType', 'schemaVersion', 'payload'])
          && d.id == eventId
          && d.timestamp is string && d.timestamp.size() <= 40
          && d.sport is string && d.sport.size() <= 40
          && d.eventType is string && d.eventType.size() <= 60
          && d.schemaVersion is int
          && d.payload is map;
      }

      allow read: if isOwner();
      allow create: if isOwner() && validEvent();
      allow update: if isOwner() && validEvent()
        && request.resource.data.diff(resource.data).affectedKeys().size() == 0;
      allow delete: if false;
    }
  }
}
